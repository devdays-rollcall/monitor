  "dependencies": {
    "@base-ui/react": "1.9.0",
    "lucide-react": "1.70.0",
    "maplibre-gl": "^6.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.65.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  }
