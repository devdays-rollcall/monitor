{
  "name": "group-tracking-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "generate": "openapi-ts -i ../openapi.yaml -o src/generated",
